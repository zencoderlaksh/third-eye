# Server Configuration
PORT=5000

# Database Configuration (Optional: Paste MongoDB Atlas URI here; if omitted, persistent file storage in backend/data/courses.json is used)
MONGODB_URI=

# ImageKit Configuration for CDN Image Uploads
# Obtain these from your ImageKit Dashboard: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
